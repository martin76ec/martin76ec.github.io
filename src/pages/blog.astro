---
import Layout from "@layouts/index.astro";
import { BlogList } from "@components/content/blogs";
import { VideoList } from "@components/content/videos";
import { ScrollArea } from "@components/ui/scroll-area";
import { ArrowLeft } from "lucide-react";
---

<Layout
  title="Blog — Martín Larrea"
  description="Writing from Martín Larrea on software engineering, AI, and independent product development."
>
  <div class="flex w-full h-full justify-center">
      <ScrollArea client:load className="w-full max-w-screen-xl px-4 md:px-10 h-full">
        <div class="pb-20">
            <div class="flex flex-col gap-4 mb-8">
              <div class="text-sm flex items-center gap-2 text-muted-foreground hover:text-foreground hover:underline md:text-base">
                <ArrowLeft className="h-4 w-4" />
                <a href="/">
                  <span>Go back</span>
                </a>
              </div>
              <p class="text-2xl font-bold text-foreground md:text-3xl">Blog Posts</p>
            </div>
            <BlogList />

            <div class="mt-16 mb-8">
              <p class="text-2xl font-bold text-foreground md:text-3xl">Videos</p>
            </div>
            <VideoList />
        </div>
      </ScrollArea>
  </div>
</Layout>
